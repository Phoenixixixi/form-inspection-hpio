model migrations_test {
  id Int @id @default(autoincrement())
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model roles {
  id          String    @id @db.VarChar(50)
  name        String    @db.VarChar(100)
  label       String    @db.VarChar(150)
  description String?
  permissions Json?     @db.Json
  created_at  DateTime? @db.Timestamp(0)
  updated_at  DateTime? @db.Timestamp(0)
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt?
  ip_address    String? @db.VarChar(45)
  user_agent    String?
  payload       String
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model shift_configs {
  id         BigInt    @id @default(autoincrement())
  shift_name String    @unique(map: "shift_configs_shift_name_unique") @db.VarChar(255)
  start_time String    @db.VarChar(255)
  end_time   String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

model shift_schedules {
  id            BigInt    @id @default(autoincrement())
  employee_name String    @db.VarChar(255)
  nip           String?   @db.VarChar(255)
  no_hp         String?   @db.VarChar(255)
  month         String    @db.VarChar(255)
  shifts        Json
  sort_order    Int       @default(0)
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
}

model staff_contacts {
  id           String    @id @db.Uuid
  full_name    String    @db.VarChar(150)
  phone_number String    @unique(map: "staff_contacts_phone_number_unique") @db.VarChar(30)
  station_name String    @db.VarChar(100)
  station_code String    @db.VarChar(10)
  role_name    String    @default("SPV Stasiun") @db.VarChar(100)
  department   String    @default("Operations & Facility") @db.VarChar(100)
  is_active    Boolean   @default(true)
  created_at   DateTime? @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
}

model stations {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  code               String               @unique
  location           String
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  alerts             alerts[]
  form_report        form_report[]
  maintenance_orders maintenance_orders[]
  stations_devices   stations_devices[]
  technicians        technicians[]
  rooms              rooms[]
  station_items      station_items[]
  inspections        inspections[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stations_devices {
  id                BigInt              @id @default(autoincrement())
  device_id         String              @db.VarChar(255)
  device_name       String              @db.VarChar(255)
  station_code      String              @db.VarChar(255)
  status            String              @db.VarChar(255)
  created_at        DateTime?           @db.Timestamp(0)
  updated_at        DateTime?           @db.Timestamp(0)
  device_components device_components[]
  stations          stations            @relation(fields: [station_code], references: [code], onDelete: Cascade, onUpdate: NoAction, map: "stations_devices_station_code_foreign")
}

model technicians {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String
  name              String
  specialization    String
  station_id        String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  maintenance_items maintenance_items[]
  stations          stations?           @relation(fields: [station_id], references: [id], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model train_sets {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  train_number       String               @unique
  model              String
  status             String               @default("operational")
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  alerts             alerts[]
  maintenance_orders maintenance_orders[]
}

model users {
  id                BigInt    @id @default(autoincrement())
  name              String    @db.VarChar(255)
  email             String    @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime? @db.Timestamp(0)
  password          String    @db.VarChar(255)
  remember_token    String?   @db.VarChar(100)
  created_at        DateTime? @db.Timestamp(0)
  updated_at        DateTime? @db.Timestamp(0)
  phone_number      String?   @db.VarChar(30)
  station_id        String?   @db.Uuid
  role_id           String?   @default("spv_station") @db.VarChar(50)
  is_active         Boolean   @default(true)
}

model rooms {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  station_id  String        @db.Uuid
  name        String        @db.VarChar(100)
  location    String?       @db.VarChar(255)
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  station     stations      @relation(fields: [station_id], references: [id], onDelete: Cascade)
  items       items[]
  inspections inspections[]
}

model items {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id          String             @db.Uuid
  name             String             @db.VarChar(100)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  room             rooms              @relation(fields: [room_id], references: [id], onDelete: Cascade)
  inspection_items inspection_items[]
}

model station_items {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  station_id       String             @db.Uuid
  name             String             @db.VarChar(100)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  station          stations           @relation(fields: [station_id], references: [id], onDelete: Cascade)
  inspection_items inspection_items[]
}

model inspections {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  station_id       String             @db.Uuid
  room_id          String?            @db.Uuid
  user_id          String             @db.VarChar(255)
  temperature      Decimal?           @db.Decimal(5, 2)
  humidity         Decimal?           @db.Decimal(5, 2)
  notes            String?            @db.Text
  inspected_at     DateTime           @default(now()) @db.Timestamptz(6)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  station          stations           @relation(fields: [station_id], references: [id], onDelete: Cascade)
  room             rooms?             @relation(fields: [room_id], references: [id], onDelete: Cascade)
  inspection_items inspection_items[]
}

model inspection_items {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspection_id   String         @db.Uuid
  item_id         String?        @db.Uuid
  station_item_id String?        @db.Uuid
  status          String         @db.VarChar(20)
  notes           String?        @db.Text
  inspection      inspections    @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  item            items?         @relation(fields: [item_id], references: [id], onDelete: Cascade)
  station_item    station_items? @relation(fields: [station_item_id], references: [id], onDelete: Cascade)
}

